# Copy to application-local.properties and replace values. Never commit the real file.
spring.config.activate.on-profile=local

# Full Secret Manager version resource, e.g. projects/your-project/secrets/GEMINI_API_KEY/versions/latest
# Do not place a raw Gemini API key in this file.
GEMINI_API_KEY_SECRET=projects/gen-lang-client-0163681294/secrets/GEMINI_API_KEY/versions/latest

# Non-secret Google Cloud identifiers used by the server-side Admin SDK.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0163681294
FIRESTORE_DATABASE_ID=ai-studio-a422770d-44d6-4305-80c0-fd2cb2cd09f0

# Frontend Firebase configuration (keep these in the separate React app).
# FIREBASE_APP_ID=1:780779131165:web:d9a8238c107fd98ceb11f4
# FIREBASE_AUTH_DOMAIN=gen-lang-client-0163681294.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=gen-lang-client-0163681294.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=780779131165
# FIREBASE_OAUTH_CLIENT_ID=780779131165-84pd5c9ls93pd62dfjfpb4504pqtb138.apps.googleusercontent.com
# FIREBASE_MEASUREMENT_ID=
# FIREBASE_RECAPTCHA_SITE_KEY=

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SERVER_PORT=8080
