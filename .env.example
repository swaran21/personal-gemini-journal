# Copy to .env.local. Use development-only values; never reuse production credentials.
POSTGRES_USER=journal_app
POSTGRES_PASSWORD=
POSTGRES_DB=journal
POSTGRES_HOST_PORT=55432
BACKEND_HOST_PORT=18080
FRONTEND_HOST_PORT=13000
DB_ADMIN_PASSWORD=
KEYCLOAK_ADMIN=local_admin
KEYCLOAK_ADMIN_PASSWORD=
OLLAMA_CHAT_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Use gemini for Flash generation and Gemini embeddings, or ollama for a fully local stack.
AI_GENERATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
JOURNAL_WRITES_PER_HOUR=30
RAG_QUERIES_PER_HOUR=20
API_REQUESTS_PER_MINUTE=120
